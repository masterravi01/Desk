{
  "name": "alfa",
  "version": "1.4.3",
  "main": "electron/main.js",
  "author": "Master Ravi",
  "description": "this is desktop app",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "electron": "electron .",
    "package": "ng build --base-href ./ && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.master.alfa",
    "productName": "Alfa",
    "directories": {
      "output": "release-builds"
    },
    "files": [
      "dist/alfa/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/assets",
        "to": "assets"
      }
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "masterravi01",
        "repo": "Desk"
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "^17.3.10",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/material": "^17.3.10",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@ngneat/until-destroy": "^10.0.0",
    "cors": "^2.8.5",
    "docx": "^9.2.0",
    "docxtemplater": "^3.60.1",
    "docxtemplater-image-module-free": "^1.1.1",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.6.2",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "libreoffice-convert": "^1.6.1",
    "number-to-words": "^1.2.4",
    "pizzip": "^3.1.8",
    "rxjs": "~7.8.0",
    "sqlite3": "^5.1.7",
    "tslib": "^2.3.0",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.2",
    "@angular/cli": "^17.3.2",
    "@angular/compiler-cli": "^17.3.0",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~5.1.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.2"
  }
}
